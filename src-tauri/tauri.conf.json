{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "moss-island",
  "version": "0.1.2",
  "identifier": "com.mossisland.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Moss Island",
        "label": "main",
        "width": 960,
        "height": 308,
        "center": false,
        "resizable": true,
        "maximizable": false,
        "minWidth": 100,
        "minHeight": 24,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' blob: data: https:; connect-src 'self' ipc: http://ipc.localhost https://api.deezer.com https://itunes.apple.com https://lrclib.net"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
